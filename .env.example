# Copy to .env and adjust as needed. Nothing here is required for CPU usage.

# Root directory for run outputs (checkpoints, benchmarks, logs).
JAXSCALE_ARTIFACTS_DIR=artifacts

# Simulate N CPU devices for multi-device development (must be set before
# the Python process starts; JAX reads it at import time).
# XLA_FLAGS=--xla_force_host_platform_device_count=8

# Serving
JAXSCALE_HOST=0.0.0.0
JAXSCALE_PORT=8000
